{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/houdini-ai/studio/proposal.schema.json",
  "title": "Studio proposal",
  "type": "object",
  "required": ["schema_version", "id", "idea_id", "track", "state", "question", "mechanism", "outputs", "stop_conditions", "runner", "cost_tier", "visibility"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "id": {"allOf": [{"$ref": "common.schema.json#/$defs/record_id"}, {"pattern": "^proposal-"}]},
    "idea_id": {"allOf": [{"$ref": "common.schema.json#/$defs/record_ref"}, {"pattern": "^idea-"}]},
    "direction_ids": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "common.schema.json#/$defs/record_ref"}, {"pattern": "^direction-"}]}, "uniqueItems": true},
    "track": {"$ref": "common.schema.json#/$defs/track"},
    "state": {"enum": ["proposed", "approved", "held", "implemented", "rejected", "archived"]},
    "question": {"$ref": "common.schema.json#/$defs/nonempty_string"},
    "hypothesis": {"$ref": "common.schema.json#/$defs/nonempty_string"},
    "mechanism": {"$ref": "common.schema.json#/$defs/nonempty_string"},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonempty_string"}, "uniqueItems": true},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonempty_string"}},
    "runner": {"$ref": "common.schema.json#/$defs/runner"},
    "cost_tier": {"$ref": "common.schema.json#/$defs/cost_tier"},
    "visibility": {"$ref": "common.schema.json#/$defs/visibility"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false
}
