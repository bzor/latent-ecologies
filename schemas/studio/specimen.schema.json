{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/houdini-ai/studio/specimen.schema.json",
  "title": "Studio specimen",
  "type": "object",
  "required": ["schema_version", "id", "state", "component_ids", "creative_reason", "deliverables", "cost_tier", "approved", "visibility"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "id": {"allOf": [{"$ref": "common.schema.json#/$defs/record_id"}, {"pattern": "^specimen-"}]},
    "state": {"enum": ["draft", "approved", "rendering", "completed", "failed", "rejected", "archived"]},
    "component_ids": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "common.schema.json#/$defs/record_ref"}, {"pattern": "^component-"}]}, "uniqueItems": true},
    "creative_reason": {"$ref": "common.schema.json#/$defs/nonempty_string"},
    "deliverables": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonempty_string"}, "uniqueItems": true},
    "cost_tier": {"$ref": "common.schema.json#/$defs/cost_tier"},
    "approved": {"type": "boolean"},
    "visibility": {"$ref": "common.schema.json#/$defs/visibility"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false
}
