{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/houdini-ai/studio/editorial.schema.json",
  "title": "Studio editorial candidate",
  "type": "object",
  "required": ["schema_version", "id", "state", "artifact_refs", "destinations", "roles", "tags", "visibility", "approved"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "id": {"allOf": [{"$ref": "common.schema.json#/$defs/record_id"}, {"pattern": "^editorial-"}]},
    "state": {"enum": ["draft", "ready-for-approval", "approved", "published", "archived"]},
    "artifact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}, "uniqueItems": true},
    "destinations": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/editorial_destination"}, "uniqueItems": true},
    "roles": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/editorial_role"}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/editorial_tag"}, "uniqueItems": true},
    "visibility": {"$ref": "common.schema.json#/$defs/visibility"},
    "approved": {"type": "boolean"},
    "title": {"$ref": "common.schema.json#/$defs/nonempty_string"},
    "summary": {"$ref": "common.schema.json#/$defs/nonempty_string"},
    "license": {"$ref": "common.schema.json#/$defs/nonempty_string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "text"],
        "properties": {
          "status": {"enum": ["measured", "derived", "observed", "hypothesized"]},
          "text": {"$ref": "common.schema.json#/$defs/nonempty_string"}
        },
        "additionalProperties": false
      }
    },
    "copy_draft": {"type": "string"},
    "accessibility_text": {"type": "string"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "approved"}}, "required": ["state"]},
      "then": {"properties": {"approved": {"const": true}}},
      "else": {"properties": {"approved": {"const": false}}}
    }
  ]
}
