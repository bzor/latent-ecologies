{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/houdini-ai/study.schema.json",
  "title": "Houdini AI study",
  "type": "object",
  "required": ["schema_version", "id", "title", "status", "reproducibility", "seed", "simulation", "presentation", "render", "publication"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["concept", "prototype", "selected", "rendering", "published", "archived"] },
    "reproducibility": { "enum": ["open", "partial", "documented", "artifact"] },
    "seed": { "type": "integer", "minimum": 0 },
    "simulation": {
      "type": "object",
      "required": ["frame_start", "frame_end", "fps", "rule_genome"],
      "properties": {
        "frame_start": { "type": "integer", "minimum": 0 },
        "frame_end": { "type": "integer", "minimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "rule_genome": { "type": "object" }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": ["quality", "mode", "look", "camera", "depth_of_field", "overlays"],
      "properties": {
        "quality": { "enum": ["probe", "study", "specimen"] },
        "mode": { "enum": ["organism", "instrument", "analysis"] },
        "look": { "type": "string", "minLength": 1 },
        "camera": { "type": "string", "minLength": 1 },
        "depth_of_field": { "type": "boolean" },
        "overlays": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "required": ["format", "width", "height", "output_pattern"],
      "properties": {
        "format": { "enum": ["png", "exr"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "output_pattern": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": ["state", "approval_required", "outputs"],
      "properties": {
        "state": { "enum": ["private", "draft", "approved", "published"] },
        "approval_required": { "const": true },
        "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

