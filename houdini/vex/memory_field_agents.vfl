// Memory Field agent update. Field points and agents share one geometry stream.
float box_sdf(float x; float y; float half_length; float half_width)
{
    float qx = abs(x) - half_length;
    float qy = abs(y) - half_width;
    return length(set(max(qx, 0.0), max(qy, 0.0), 0)) + min(max(qx, qy), 0.0);
}

float artifact_sdf(vector position; float hub_radius; float arm_length; float arm_half_width; float orientation)
{
    float distance = length(set(position.x, position.y, 0)) - hub_radius;
    float arm_start = hub_radius * 0.45;
    float half_length = arm_length * 0.5;
    float center = arm_start + half_length;
    for (int index = 0; index < 3; index++)
    {
        float angle = orientation + index * 6.28318530718 / 3.0;
        vector direction = set(cos(angle), sin(angle), 0);
        vector perpendicular = set(-sin(angle), cos(angle), 0);
        float along = dot(position, direction) - center;
        float lateral = dot(position, perpendicular);
        distance = min(distance, box_sdf(along, lateral, half_length, arm_half_width));
    }
    return distance;
}

if (i@kind != 0)
    return;

float dt = 1.0 / chf("fps");
float sense = chf("sense_radius");
vector resource_sum = 0;
vector inhibition_sum = 0;
vector occupancy_sum = 0;
float resource_weight = 0;
float inhibition_weight = 0;
int occupancy_count = 0;

int nearby[] = nearpoints(0, @P, sense, 96);
foreach (int point_number; nearby)
{
    int kind = point(0, "kind", point_number);
    vector sample_position = point(0, "P", point_number);
    vector offset = sample_position - @P;
    float distance_weight = max(0.0, 1.0 - length(offset) / sense);
    if (kind == 1)
    {
        float resource = point(0, "resource", point_number);
        float inhibition = point(0, "inhibition", point_number);
        resource_sum += offset * resource * distance_weight;
        inhibition_sum += offset * inhibition * distance_weight;
        resource_weight += resource * distance_weight;
        inhibition_weight += inhibition * distance_weight;
    }
    else if (kind == 0 && point_number != @ptnum)
    {
        occupancy_sum -= normalize(offset + set(1e-6, 0, 0)) * distance_weight;
        occupancy_count++;
    }
}

v@resource_steer = resource_weight > 1e-6 ? normalize(resource_sum) : 0;
v@inhibition_steer = inhibition_weight > 1e-6 ? -normalize(inhibition_sum) : 0;
v@occupancy_steer = occupancy_count > 0 ? normalize(occupancy_sum) : 0;
f@local_resource = resource_weight / max(1, len(nearby));
f@local_inhibition = inhibition_weight / max(1, len(nearby));

float hub_radius = chf("relic_hub_radius");
float arm_length = chf("relic_arm_length");
float arm_half_width = chf("relic_arm_half_width");
float orientation = chf("relic_orientation");
f@relic_distance = artifact_sdf(@P, hub_radius, arm_length, arm_half_width, orientation);
float normal_step = 0.002;
float normal_x = artifact_sdf(@P + set(normal_step, 0, 0), hub_radius, arm_length, arm_half_width, orientation) -
    artifact_sdf(@P - set(normal_step, 0, 0), hub_radius, arm_length, arm_half_width, orientation);
float normal_y = artifact_sdf(@P + set(0, normal_step, 0), hub_radius, arm_length, arm_half_width, orientation) -
    artifact_sdf(@P - set(0, normal_step, 0), hub_radius, arm_length, arm_half_width, orientation);
vector relic_normal = normalize(set(normal_x, normal_y, 0) + set(1e-6, 0, 0));
v@relic_normal = relic_normal;
v@relic_tangent = i@orbit_direction >= 0 ? set(-relic_normal.y, relic_normal.x, 0) :
    set(relic_normal.y, -relic_normal.x, 0);
v@relic_avoidance = f@relic_distance < chf("relic_avoid_distance") ?
    relic_normal * (1.0 - max(0, f@relic_distance) / chf("relic_avoid_distance")) : 0;
v@relic_resource_attraction = f@relic_distance < chf("relic_attract_distance") && f@relic_distance > 0 ?
    -relic_normal * (1.0 - f@relic_distance / chf("relic_attract_distance")) : 0;

vector boundary = 0;
float half_width = chf("domain_width") * 0.5;
float half_height = chf("domain_height") * 0.5;
float margin = chf("boundary_margin");
if (@P.x > half_width - margin) boundary.x -= 1.0 - (half_width - @P.x) / margin;
if (@P.x < -half_width + margin) boundary.x += 1.0 - (half_width + @P.x) / margin;
if (@P.y > half_height - margin) boundary.y -= 1.0 - (half_height - @P.y) / margin;
if (@P.y < -half_height + margin) boundary.y += 1.0 - (half_height + @P.y) / margin;
v@boundary_steer = boundary;

vector acceleration =
    v@resource_steer * chf("resource_weight") +
    v@inhibition_steer * chf("inhibition_weight") +
    v@occupancy_steer * chf("occupancy_weight") +
    v@relic_avoidance * chf("relic_avoid_weight") +
    v@relic_tangent * length(v@relic_avoidance) * chf("relic_tangent_weight") +
    v@relic_resource_attraction * chf("relic_attract_weight") +
    v@boundary_steer * chf("boundary_weight");

v@v += acceleration * dt;
float speed = length(v@v);
if (speed > chf("max_speed"))
    v@v = normalize(v@v) * chf("max_speed");
if (speed < chf("min_speed"))
    v@v = normalize(v@v + set(1e-6, 0, 0)) * chf("min_speed");

vector candidate = @P + v@v * dt;
float candidate_distance = artifact_sdf(candidate, hub_radius, arm_length, arm_half_width, orientation);
if (candidate_distance <= 0)
{
    float candidate_x = artifact_sdf(candidate + set(normal_step, 0, 0), hub_radius, arm_length, arm_half_width, orientation) -
        artifact_sdf(candidate - set(normal_step, 0, 0), hub_radius, arm_length, arm_half_width, orientation);
    float candidate_y = artifact_sdf(candidate + set(0, normal_step, 0), hub_radius, arm_length, arm_half_width, orientation) -
        artifact_sdf(candidate - set(0, normal_step, 0), hub_radius, arm_length, arm_half_width, orientation);
    vector candidate_normal = normalize(set(candidate_x, candidate_y, 0) + set(1e-6, 0, 0));
    candidate += candidate_normal * (-candidate_distance + 0.02);
    v@v = reflect(v@v, -candidate_normal);
    i@boundary_contact = 1;
}
else
    i@boundary_contact = 0;
if (abs(candidate.x) > half_width || abs(candidate.y) > half_height)
    i@boundary_contact = 1;
candidate.x = clamp(candidate.x, -half_width, half_width);
candidate.y = clamp(candidate.y, -half_height, half_height);
@P = candidate;

f@speed = length(v@v);
f@resource_intake += f@local_resource * chf("consume_rate") * dt;
f@deposit_strength = clamp(f@speed / chf("max_speed"), 0, 1);
i@age += 1;
i@state = f@speed < chf("dormant_speed") ? 1 : 0;
