// Study 002: analytic O(N) flow kernel for very large populations.
float dt = 1.0 / chf("fps");
float time = chf("current_frame") * dt;
float scale = chf("flow_scale");
float phase_angle = i@phase * 2.09439510239;

vector position = @P;
vector flow = set(
    sin(position.y * scale + time * 0.72 + phase_angle)
        + 0.42 * cos((position.x + position.y) * scale * 0.61 - time * 0.44),
    0.58 + cos(position.x * scale - time * 0.53 + phase_angle) * 0.72
        - 0.34 * sin((position.x - position.y) * scale * 0.48 + time * 0.37),
    (0.46 * sin((position.x + position.y) * scale * 0.55 + time * 0.41 - phase_angle)
        + 0.22 * cos(position.z * scale * 0.83 - time * 0.29 + phase_angle)) * chf("depth_strength")
);
flow = normalize(flow + set(1e-6, 0, 0)) * chf("flow_strength");

float phase_center = sin(position.y * 0.43 + phase_angle + time * 0.31) * 2.65;
float depth_center = sin(position.y * 0.31 - phase_angle + time * 0.23) * chf("domain_depth") * 0.32;
vector phase_pull = set(phase_center - position.x, 0, depth_center - position.z) * chf("phase_strength");

// Stable IDs begin as interleaved samples along the phase ribbons. Inspect a fixed
// cohort around each ID, then filter it by true 3D distance. This avoids unstable
// spatial-index tie ordering while retaining local flock-like interaction.
vector alignment_sum = 0;
vector cohesion_center = 0;
vector same_separation = 0;
vector cross_separation = 0;
float same_count = 0;
float same_separation_weight = 0;
float cross_separation_weight = 0;
float flock_radius = chf("flock_radius");
float avoidance_radius = chf("avoidance_radius");
float separation_radius = chf("separation_radius");
int point_count = npoints(1);
int id_window = chi("flock_id_window");
for (int id_offset = -id_window; id_offset <= id_window; id_offset++)
{
    if (id_offset == 0)
        continue;
    int neighbor = (@ptnum + id_offset + point_count) % point_count;
    if (neighbor == @ptnum)
        continue;
    vector offset = position - point(1, "P", neighbor);
    float distance = length(offset);
    if (distance <= 1e-6 || distance > flock_radius)
        continue;
    if (point(1, "phase", neighbor) == i@phase)
    {
        alignment_sum += point(1, "v", neighbor);
        cohesion_center += point(1, "P", neighbor);
        same_count += 1;
        float weight = 1.0 - smooth(0.0, separation_radius, distance);
        same_separation += normalize(offset) * weight;
        same_separation_weight += weight;
    }
    else if (distance < avoidance_radius)
    {
        float weight = 1.0 - smooth(0.0, avoidance_radius, distance);
        cross_separation += normalize(offset) * weight;
        cross_separation_weight += weight;
    }
}
vector flocking = 0;
if (same_count > 0)
{
    vector average_velocity = alignment_sum / same_count;
    if (length(average_velocity) > 1e-6)
        flocking += normalize(average_velocity) * chf("alignment_strength");
    vector center_offset = cohesion_center / same_count - position;
    if (length(center_offset) > 1e-6)
        flocking += normalize(center_offset) * chf("cohesion_strength");
}
if (same_separation_weight > 0)
    flocking += same_separation / same_separation_weight * chf("separation_strength");
if (cross_separation_weight > 0)
    flocking += cross_separation / cross_separation_weight * chf("avoidance_strength");

float wander_phase = @id * 0.754877666 + time * 0.47;
vector wander = normalize(set(
    sin(wander_phase * 1.13),
    cos(wander_phase * 0.79 + 1.7),
    sin(wander_phase * 0.61 + 3.1)
)) * chf("wander_strength");

vector desired = limit_length(flow + phase_pull + flocking + wander, chf("max_speed"));
v@v = limit_length(v@v * chf("drag") + desired * (1.0 - chf("drag")), chf("max_speed"));
@P += v@v * dt;
@P.x = fold_axis(@P.x, chf("domain_width") * 0.5);
@P.y = fold_axis(@P.y, chf("domain_height") * 0.5);
@P.z = fold_axis(@P.z, chf("domain_depth") * 0.5);

f@speed = length(v@v);
f@curvature = length(v@v - v@previous_v) / max(dt, 1e-6);
v@previous_v = v@v;
f@density_hint = smooth(0.0, 1.0, 1.0 - length(set(@P.x - phase_center, 0, @P.z - depth_center)) / 2.2);
